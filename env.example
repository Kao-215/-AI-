# 從 LINE Developers Console -> Messaging API 取得
CHANNEL_ACCESS_TOKEN=your_channel_access_token
CHANNEL_SECRET=your_channel_secret

# 管理人員的 LINE userId（可多個，用逗號分隔）
# 取得方式：管理人員第一次跟 Bot 說話時，把 webhook log 印出的 userId 記下來
ADMIN_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Uyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# 管理單位聯絡方式（自動回覆用）
CONTACT_INFO=管理處分機：02-1234-5678 轉 100｜服務時間：週一至週五 09:00-18:00

# Server port
PORT=3000

# 進駐費到期前幾天開始通知（可多個，用逗號分隔，例如 7,3,1 代表到期前7天/3天/1天各提醒一次）
FEE_REMINDER_DAYS_BEFORE=7,3,1

# 每天檢查進駐費的時間（cron 格式，預設每天早上9點）
FEE_CHECK_CRON=0 9 * * *
